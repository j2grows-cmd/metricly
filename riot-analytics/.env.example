# Copy this file to .env and fill in your Riot Development API key.
RIOT_API_KEY=RGAPI-your-key-here

RIOT_GAME_NAME=J2GNinja
RIOT_TAGLINE=J2G

# EUW platform routing and Europe regional routing
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# "all" or a positive number such as 100, 500, 1000
MATCH_LIMIT=all

# Match timeline endpoint adds substantial requests; true enables it.
INCLUDE_TIMELINES=true

# Conservative default. Riot limits vary by key and product.
REQUESTS_PER_SECOND=0.8
